#!/usr/bin/env bash

# Launch worktree-tui. Bound to <prefix>+g in tmux, which opens it in a
# centred popup. The popup does not inherit the interactive shell's PATH,
# so resolve the binary explicitly.

set -uo pipefail

for candidate in \
    "$HOME/.local/bin/worktree-tui" \
    "$HOME/go/bin/worktree-tui" \
    "$(command -v worktree-tui 2>/dev/null)"
do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

cat <<'MSG'

  worktree-tui is not installed.

  Install it with:

      ~/.dotfiles/tools/install-tools

MSG

read -rsn1 -p "  Press any key to close..."
echo
